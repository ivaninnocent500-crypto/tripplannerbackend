# Supabase knowledge-base + trip-instance database (both live in the same
# Postgres project — travel_places, lodges, cabinets, shelves, etc.)
SUPABASE_DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Shared-secret auth for the Android app (X-Api-Key header)
ATI_API_KEY=change-me-to-a-long-random-value

# Optional — only needed if ExplanationEngine's output is narrated by AI
ATI_AI_ENABLED=false
OPENAI_API_KEY=
GEMINI_API_KEY=

CORS_ALLOWED_ORIGINS=*
LOG_LEVEL=INFO
